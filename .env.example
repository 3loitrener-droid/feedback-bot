# Database — берём строку подключения из Neon (neon.tech)
# Пример: postgresql+asyncpg://user:password@ep-xxx.eu-central-1.aws.neon.tech/feedback_bot?sslmode=require
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Telegram — токен от @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# LLM — выбрать провайдера: "anthropic" или "groq"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=claude-sonnet-4-6

# Groq (бесплатная альтернатива Claude)
# LLM_PROVIDER=groq
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# Auth — сгенерируйте случайную строку длиной 32+ символа
SECRET_KEY=your_super_secret_key_change_in_production_min_32_chars

# App — URL вашего Koyeb-сервиса (заполнить после деплоя)
APP_URL=https://your-service.koyeb.app
API_URL=https://your-service.koyeb.app
ENVIRONMENT=production
